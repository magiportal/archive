# ─────────────────────────────────────────────────────────────
#  MAGI Portal — Apache config for DreamHost (rmitmagi.com)
#
#  Upload this to the domain root alongside index.html. DreamHost runs
#  Apache with .htaccess enabled, so it takes effect immediately.
# ─────────────────────────────────────────────────────────────

# ── FORCE HTTPS ──────────────────────────────────────────────
# Not optional for this site. The password gates and the archive's ownership
# tokens both use crypto.subtle (see gate-auth.js / owner-token.js), and
# browsers only expose that API in a secure context. Over plain http:// the
# gates fail closed with "Can't verify here" and nobody can unlock anything.
# Turn on the free Let's Encrypt cert in the DreamHost panel first, or this
# redirect will loop into a certificate warning.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.rmitmagi.com → rmitmagi.com (one canonical host, so the session keys
  # the gates write aren't split across two origins)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Let's Encrypt validates by fetching a token over plain http from
  # /.well-known/acme-challenge/. Excluding it from the redirect keeps both
  # the first issue and every 60-day renewal working even if anything about
  # the https side is misconfigured.
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/

  # http → https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── KEEP NON-PUBLIC FILES OUT OF THE WEBROOT ─────────────────
# Belt and braces: these shouldn't be uploaded at all (see DEPLOY.md), but if
# one slips through, don't serve it. The .sql files spell out the schema and
# the RLS policies; SECURITY.md documents the threat model and which
# passwords are already burned.
<FilesMatch "\.(sql|md|log|bak|old|orig|yml|yaml|json5)$">
  Require all denied
</FilesMatch>

# Dotfiles — .git most of all. A served .git directory lets anyone reconstruct
# the whole repository, which for this project includes the commits where the
# old passwords were still in plaintext.
RedirectMatch 404 /\.(?!well-known/)

# No directory listings for folders without an index (e.g. /media/).
Options -Indexes

# ── MIME TYPES ───────────────────────────────────────────────
# Older Apache builds don't know these; without them the browser downloads the
# file instead of rendering it.
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType image/avif                 .avif
  AddType video/mp4                  .mp4
  AddType font/woff2                 .woff2
  AddType font/woff                  .woff
  AddType application/pdf            .pdf
  AddType text/css                   .css
  AddType application/javascript     .js
</IfModule>

# ── COMPRESSION ──────────────────────────────────────────────
# Text only. Images, video and woff2 are already compressed — re-compressing
# them burns CPU for nothing.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── CACHING ──────────────────────────────────────────────────
# Media and fonts are effectively immutable — they get new filenames when they
# change — so they can cache hard. HTML/CSS/JS are cached briefly instead:
# there's no build step adding content hashes to those filenames, so a long
# TTL would strand visitors on an old copy after an edit.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 hour"

  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"

  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 hour"
  ExpiresByType application/javascript  "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|jpe?g|png|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always revalidate the pages themselves, so a content edit shows up on the
  # next load rather than whenever a stale cache happens to expire.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ── SECURITY HEADERS ──
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Deny framing of our own pages. Note this doesn't restrict the frames the
  # site itself embeds (Vimeo, YouTube, SoundCloud, the Office viewer) — those
  # are outbound and unaffected.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS: only safe once HTTPS is confirmed working. Left commented until the
  # cert is live — enabling it early locks browsers onto https for a year and
  # is painful to undo if something's misconfigured.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── RENAMED PAGES ────────────────────────────────────────────
# studio -> board, research -> archive (Jul 2026). Permanent redirects so
# anything already pointing at the old paths keeps working: bookmarks, links
# from the EXPO sites, anything shared in Teams, and any search engine that
# indexed them. 301 (not 302) tells crawlers the move is permanent and
# transfers the old URL's standing to the new one.
#
# Placed ABOVE the .html-stripping rules below so it wins first — otherwise
# /studio.html would be rewritten to /studio and 404 before ever reaching a
# redirect. Hashes (#some-id) survive automatically; browsers reattach the
# fragment after a redirect, so archive deep links from the board still land
# on the right item.
<IfModule mod_rewrite.c>
  RewriteRule ^studio(\.html)?$   /board   [R=301,L]
  RewriteRule ^research(\.html)?$ /archive [R=301,L]
</IfModule>

# ── PRETTY URLS: hide .html from the address bar ─────────────
# Two halves, and both are needed — one alone only gets you partway:
#
#   1. VISIBLE half: someone requests /alumni.html directly (an old link,
#      a bookmark, or the site's own <a href="alumni.html">) → 301 redirect
#      to /alumni. This is what actually changes the address bar; without
#      it, a request for the .html form serves fine but keeps showing .html,
#      no matter what the server is also willing to accept.
#   2. SERVING half (below): the browser is now asking for /alumni, which
#      isn't a real file — internally map it back to alumni.html so Apache
#      has something to serve. This step is invisible; the address bar
#      keeps showing /alumni.
#
# %{THE_REQUEST} (the raw request line) rather than %{REQUEST_URI} is what
# lets this fire only on the ORIGINAL browser request — REQUEST_URI would
# still show .html during step 2's internal rewrite and this would loop.
<IfModule mod_rewrite.c>
  # /index.html -> / (not /index — the homepage has no extensionless name
  # of its own, "index" isn't meant to appear in the address bar)
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s#] [NC]
  RewriteRule ^index\.html$ /? [R=301,L]

  # anything-else.html -> anything-else, preserving ?query and #fragment
  RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.html[?\s#] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /index.html
